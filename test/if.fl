if true then {
    :print("if statement true");
}

if false then {
    :print("should not print");
}

if true then {
    :print("then branch");
} else {
    :print("else branch");
}

if false then {
    :print("should not print");
} else {
    :print("else taken");
}

let a = if true then { 1 } else { 2 };
:assert(a == 1);

let b = if false then { 10 } else { 20 };
:assert(b == 20);

let c = if true then {
    let x = 3;
    let y = 4;
    x + y
} else {
    0
};
:assert(c == 7);

let d = if false then {
    0
} else {
    let x = 10;
    x * 5
};
:assert(d == 50);

let e = if true then {
    if false then { 1 } else { 2 }
} else {
    3
};
:assert(e == 2);

let flag = true;
let f = if flag then { 42 } else { 0 };
:assert(f == 42);

let g = if 1 == 1 then { 100 } else { 200 };
:assert(g == 100);

let h = if 1 == 2 then { 100 } else { 200 };
:assert(h == 200);

if 3 == 3 then {
    :print("equal");
} else {
    :print("not equal");
}

let i = if false then { 1 } else if true then { 2 } else { 3 };
:assert(i == 2);

let j = if false then { 10 } else if false then { 20 } else { 30 };
:assert(j == 30);

let k = if true then { 100 } else if true then { 200 } else { 300 };
:assert(k == 100);

let l = if false then { 1 } else if false then { 2 } else if true then { 3 } else { 4 };
:assert(l == 3);

if false then {
    :print("should not print");
} else if true then {
    :print("else if taken");
} else {
    :print("should not print");
}

if true then {
    :print("unit if");
}
