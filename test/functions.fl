fn add(a: int, b: int): int {
    a + b
}

fn always_true(): bool {
    true
}

fn no_op() {
    :print("no_op called");
}

fn outer(): unit {
    fn inner(): unit {
        :print("nested");
    }
    inner();
    :print("outer");
}

fn block_scoped(): unit {
    {
        fn hidden(): unit {
            :print("block-scoped");
        }
        hidden();
    };
}

fn order(): unit {
    {
    	{
			later();
    	}
    }
    
	fn later(): unit {
		:print("later");
	}
}

:assert(add(1, 2) == 3);
:assert(add(10, add(3, 4)) == 17);
:assert(always_true());
no_op();
outer();
block_scoped();
order();
