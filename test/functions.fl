fn add(a: int, b: int): int {
    a + b
}

fn always_true(): bool {
    true
}

fn no_op() {
    :print("no_op called");
}

fn outer(): unit {
    fn inner(): unit {
        :print("nested");
    }
    inner();
    :print("outer");
}

fn block_scoped(): unit {
    {
        fn hidden(): unit {
            :print("block-scoped");
        }
        hidden();
    };
}

fn order(): unit {
    {
    	{
			later();
    	}
    }
    
	fn later(): unit {
		:print("later");
	}
}

fn early_return(x: int): int {
    return x * 2;
    :print("should not print");
}

fn branch_return(x: int): int {
    if x == 0 then {
        return 42;
    };
    x
}

fn both_branches(x: bool): int {
    if x then {
        return 1;
    } else {
        return 2;
    };
}

fn nested_return(): int {
    {
        return 99;
    };
}

fn unit_return(x: bool): unit {
    if x then {
        return;
    };
    :print("not returned");
}

unit_return(true);
unit_return(false);

:assert(early_return(5) == 10);
:assert(branch_return(0) == 42);
:assert(branch_return(7) == 7);
:assert(both_branches(true) == 1);
:assert(both_branches(false) == 2);
:assert(nested_return() == 99);

:assert(add(1, 2) == 3);
:assert(add(10, add(3, 4)) == 17);
:assert(always_true());
no_op();
outer();
block_scoped();
order();
