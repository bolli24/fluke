enum Empty {}

enum Direction {
    Up, Down, Left, Right
}

let a = Direction.Up;

:assert(:enum_to_int(a) == :enum_to_int(Direction.Up));

:assert(:enum_to_int(Direction.Down) == 1);
:assert(:enum_to_int(Direction.Left) == 2);
:assert(:enum_to_int(Direction.Right) == 3);

fn is_up(d: Direction): bool {
    :enum_to_int(d) == :enum_to_int(Direction.Up)
}

:assert(is_up(a));
:assert(!is_up(Direction.Down));

:print(a);

struct DirectionBox {
    direction: Direction,
}

let box = DirectionBox { direction: Direction.Left };
:assert(:enum_to_int(box.direction) == :enum_to_int(Direction.Left));

enum Shape {
    Point,
    Circle { radius: int },
    Rect { width: int, height: int },
}

let s = Shape.Point;
:assert(:enum_to_int(s) == 0);

let c = Shape.Circle { radius: 5 };
:assert(:enum_to_int(c) == 1);

let r = Shape.Rect { width: 3, height: 4 };
:assert(:enum_to_int(r) == 2);

if let Shape.Circle { radius } = c {
    :assert(radius == 5);
} else {
    :assert(false);
}

if let Shape.Rect { width, height } = c {
    :assert(false);
} else {
    :assert(true);
}

if let Shape.Rect { width, height } = r {
    :assert(width == 3);
    :assert(height == 4);
}

if let Direction.Up = a {
    :assert(true);
} else {
    :assert(false);
}

if let Direction.Down = a {
    :assert(false);
}