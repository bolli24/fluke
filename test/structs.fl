struct Point {
    x: int,
    y: int,
}

struct Color {
    r: int,
    g: int,
    b: int,
}

struct Unit {}

struct Person {
    age: int,
    active: bool,
    pos: Point,
}

struct Node {
    value: int,
    next: Leaf,
}

struct Leaf {
    value: int,
}

let p = Point { x: 1, y: 2 };
let black = Color { r: 0, g: 0, b: 0 };
let u = Unit {};
let leaf = Leaf { value: 5 };
let node = Node { value: 1, next: Leaf { value: 2 } };
let person = Person { age: 30, active: true, pos: Point { x: 3, y: 4 } };