        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>fluke</RootNamespace>
    </PropertyGroup>

    <PropertyGroup>
        <WarningsAsErrors>CS8509</WarningsAsErrors>
