<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <PropertyGroup>
        <WarningsAsErrors>CS8509</WarningsAsErrors>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="fluke.Tests"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="fluke.Tests/**"/>
        <Compile Remove="fluke.Core/**"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Spectre.Console.Cli" Version="0.55.0"/>
        <PackageReference Include="Microsoft.ILVerification" Version="10.0.6"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="fluke.Core/fluke.Core.csproj"/>
    </ItemGroup>

</Project>
